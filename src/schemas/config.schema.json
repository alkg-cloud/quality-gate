{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qg://config.schema.json",
  "type": "object",
  "required": ["schema_version", "default_branch", "thresholds", "ratchet", "metrics", "adapter"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "default_branch": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "thresholds": {
      "type": "object",
      "required": ["MAX_FILE_LINES", "MIN_NEW_FILE_COVERAGE"],
      "additionalProperties": false,
      "properties": {
        "MAX_FILE_LINES": { "type": "integer", "minimum": 1 },
        "MIN_NEW_FILE_COVERAGE": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "ratchet": {
      "type": "object",
      "required": ["strict", "epsilon"],
      "additionalProperties": false,
      "properties": {
        "strict": { "type": "boolean" },
        "epsilon": { "type": "number", "minimum": 0 }
      },
      "allOf": [
        {
          "if":   { "properties": { "strict": { "const": true } } },
          "then": { "properties": { "epsilon": { "const": 0 } } }
        }
      ]
    },
    "metrics": {
      "type": "object",
      "required": ["coverage", "duplication", "lint", "file_size", "security"],
      "additionalProperties": false,
      "properties": {
        "coverage":    { "type": "object", "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } },
        "duplication": { "type": "object", "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } },
        "lint":        { "type": "object", "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } },
        "file_size":   { "type": "object", "required": ["enabled"], "properties": { "enabled": { "type": "boolean" } } },
        "security": {
          "type": "object",
          "required": ["enabled", "block_severities", "warn_severities"],
          "properties": {
            "enabled": { "type": "boolean" },
            "block_severities": { "type": "array", "items": { "enum": ["critical", "high", "moderate", "low"] } },
            "warn_severities":  { "type": "array", "items": { "enum": ["critical", "high", "moderate", "low"] } }
          }
        }
      }
    },
    "adapter": {
      "type": "object",
      "required": ["command", "name", "version"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
