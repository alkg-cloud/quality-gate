{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qg://lint.schema.json",
  "oneOf": [
    {
      "type": "object",
      "required": ["total", "by_file"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_file": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "count"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["_skipped"],
      "additionalProperties": false,
      "properties": { "_skipped": { "type": "string", "minLength": 1 } }
    }
  ]
}
