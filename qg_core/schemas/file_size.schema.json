{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qg://file_size.schema.json",
  "oneOf": [
    {
      "type": "object",
      "required": ["max_lines", "violations"],
      "additionalProperties": false,
      "properties": {
        "max_lines": { "type": "integer", "minimum": 1 },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "lines"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "lines": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["_skipped"],
      "additionalProperties": false,
      "properties": { "_skipped": { "type": "string", "minLength": 1 } }
    }
  ]
}
